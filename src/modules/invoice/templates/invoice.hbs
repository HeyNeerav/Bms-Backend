<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --bg: #f5f7fb;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --primary: #1d4ed8;
        --header: #172554;
      }

      body {
        font-family: "Inter", sans-serif;
        background: var(--bg);
        padding: 32px;
        color: var(--text);
      }

      .invoice {
        max-width: 920px;
        margin: auto;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
      }

      .header {
        background: var(--header);
        color: white;
        padding: 32px 40px;
        display: flex;
        justify-content: space-between;
        gap: 40px;
        flex-wrap: wrap;
      }

      .brand h1 {
        font-size: 24px;
        margin-bottom: 10px;
      }

      .brand p {
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.7;
        font-size: 14px;
      }

      .invoice-meta {
        text-align: right;
      }

      .invoice-meta h2 {
        font-size: 34px;
        margin-bottom: 18px;
        font-weight: 700;
      }

      .meta {
        display: grid;
        gap: 10px;
        font-size: 14px;
      }

      .meta div {
        display: flex;
        gap: 24px;
        justify-content: space-between;
      }

      .meta span:first-child {
        color: rgba(255, 255, 255, 0.65);
      }

      .body {
        padding: 36px 40px;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
      }

      .card {
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px;
      }

      .card h3 {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--primary);
        margin-bottom: 14px;
      }

      .card p {
        line-height: 1.8;
        font-size: 14px;
        color: #334155;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 32px;
      }

      thead {
        background: #f8fafc;
      }

      th {
        text-align: left;
        padding: 14px 16px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        border-bottom: 1px solid var(--border);
      }

      td {
        padding: 18px 16px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        vertical-align: middle;
      }

      .product {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .product img {
        width: 54px;
        height: 54px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--border);
        flex-shrink: 0;
      }

      .product-info h4 {
        font-size: 14px;
        margin-bottom: 4px;
      }

      .product-info p {
        font-size: 13px;
        color: var(--muted);
      }

      .right {
        text-align: right;
        font-weight: 500;
      }

      .bottom {
        display: flex;
        justify-content: space-between;
        gap: 32px;
        align-items: flex-start;
        flex-wrap: wrap;
      }

      .notes {
        flex: 1;
        min-width: 260px;
      }

      .notes h3 {
        margin-bottom: 12px;
        font-size: 16px;
      }

      .notes p {
        color: var(--muted);
        line-height: 1.8;
        font-size: 14px;
      }

      .summary {
        width: 320px;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px;
      }

      .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 14px;
      }

      .summary-row span:first-child {
        color: var(--muted);
      }

      .total {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .total h2 {
        font-size: 15px;
      }

      .total span {
        font-size: 28px;
        font-weight: 700;
        color: var(--primary);
      }

      .footer {
        margin-top: 36px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--muted);
      }

      @media (max-width: 768px) {
        body {
          padding: 14px;
        }

        .header,
        .body {
          padding: 24px;
        }

        .invoice-meta {
          text-align: left;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .bottom {
          flex-direction: column;
        }

        .summary {
          width: 100%;
        }

        table {
          display: block;
          overflow-x: auto;
        }
      }

      @page {
        size: A4 portrait;
        margin: 10mm;
      }

      @media print {
        body {
          padding: 0;
          background: white;
        }

        .invoice {
          max-width: none;
          border: none;
          border-radius: 0;
          overflow: visible;
        }

        .header {
          padding: 24px 28px;
        }

        .body {
          padding: 24px 28px;
        }

        .grid {
          margin-bottom: 20px;
          gap: 16px;
        }

        .card {
          padding: 14px;
        }

        table {
          margin-bottom: 20px;
        }

        th {
          padding: 10px 12px;
        }

        td {
          padding: 12px;
        }

        .product img {
          width: 42px;
          height: 42px;
        }

        .bottom {
          gap: 20px;
        }

        .summary {
          padding: 16px;
        }

        .footer {
          margin-top: 24px;
        }

        tr {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>

    <div class="invoice">
      <header class="header">
        <div class="brand">
          <h1>{{businessId.name}}</h1>

          <p>
            {{businessId.address}}<br />
            {{businessId.email}}<br />
            {{businessId.phone}}
          </p>

        </div>

        <div class="invoice-meta">
          <h2>Invoice</h2>

          <div class="meta">
            <div>
              <span>Inv. #</span>
              <span>{{invoiceNumber}}</span>
            </div>

            <div>
              <span>Date</span>
              <span>{{formatDate issuedDate}}</span>
            </div>

            <div>
              <span>Status</span>
              <span>{{status}}</span>
            </div>
          </div>
        </div>

      </header>

      <main class="body">

        <div class="grid">

          <div class="card">

            <h3>Bill To</h3>
            <p>
              {{client.name}}<br />
              {{client.company}}
              <br />
              {{client.email}}
            </p>
          </div>

        </div>

        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th class="right">Qty</th>
              <th class="right">Price</th>
              <th class="right">Total</th>
            </tr>
          </thead>

          <tbody>
            {{#each items}}
              <tr>
                <td>
                  <div class="product">
                    {{#if this.productId.image.url}}
                      <img src="{{this.productId.image.url}}" alt="" />
                    {{/if}}
                    <div class="product-info">
                      <h4>{{this.name}}</h4>
                      <p>{{this.productId.description}}</p>
                    </div>
                  </div>
                </td>
                <td class="right">{{this.quantity}}</td>
                <td class="right">{{formatCurrency this.price}}</td>
                <td class="right">{{formatCurrency this.total}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>

        <div class="bottom">
          <div class="notes">
            <h3>Notes</h3>
            <p>
              Thank you for your business. Please contact us for any invoice
              related questions.
            </p>
          </div>

          <div class="summary">

            <div class="summary-row">
              <span>Subtotal</span>
              <strong>{{formatCurrency subtotal}}</strong>
            </div>

            <div class="summary-row">
              <span>Tax</span>
              <strong>{{tax}}%</strong>
            </div>

            <div class="summary-row">
              <span>Discount</span>
              <strong>{{discount}}%</strong>
            </div>

            <div class="total">
              <h2>Total</h2>
              <span>{{formatCurrency total}}</span>
            </div>
          </div>
        </div>

        <div class="footer">
          <div>
            Generated electronically
          </div>
          <div>
            No signature required
          </div>
        </div>
      </main>

    </div>

  </body>
</html>